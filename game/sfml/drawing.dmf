# Rectangle drawing utility.
#}

import sfml as sfml;
import game.rect as r;
import game.vectors as v;
import game.math as math;

fun drawRectangle(rect: ref r.Rectangle) = {
    sfml.draw_rectangle(
        x        = rect.pos.x - rect.width / 2.0,
        y        = rect.pos.y - rect.height / 2.0,
        width    = rect.width,
        height   = rect.height,
        rotation = rect.rotation * (180.0 / math.pi) # radians to degrees
    );

    # sfml.draw_debug_arrow(0.0, 0.0, rect.pos.x, rect.pos.y);
}
